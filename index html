<!DOCTYPE html>
<html lang="sw">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Contact</title>
<style>
:root{--bg:#fff;--bg2:#f1f3f4;--sf:#f8fafd;--tx:#202124;--tx2:#5f6368;--bd:#dadce0;--pr:#0b57d0;--prbg:#d3e3fd;--dg:#d93025;color-scheme:light}
@media(prefers-color-scheme:dark){:root{--bg:#1f1f1f;--bg2:#2d2e30;--sf:#171717;--tx:#e3e3e3;--tx2:#a8abaf;--bd:#444746;--pr:#a8c7fa;--prbg:#0842a0;--dg:#f28b82;color-scheme:dark}}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{font:14px/1.4 "Google Sans",Roboto,system-ui,sans-serif;background:var(--bg);color:var(--tx)}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer;border:0;background:none}
:focus-visible{outline:2px solid var(--pr);outline-offset:2px}
.hide{display:none!important}
.btn{padding:9px 20px;border-radius:20px;font-weight:500}
.btn.p{background:var(--pr);color:var(--bg)}
.btn.t{color:var(--pr)}.btn.t:hover{background:var(--prbg)}
.btn.d{color:var(--dg)}
.ib{width:40px;height:40px;border-radius:50%;font-size:20px;color:var(--tx2);display:grid;place-items:center}
.ib:hover{background:var(--bg2)}
input,select,textarea{width:100%;padding:10px 12px;border:1px solid var(--bd);border-radius:8px;background:var(--bg)}
textarea{resize:vertical;min-height:70px}
label{display:block;color:var(--tx2);font-size:12px;margin:12px 0 4px}
.err{color:var(--dg);min-height:20px;margin:8px 0}
/* auth + lock */
.ov{position:fixed;inset:0;background:var(--sf);display:grid;place-items:center;padding:16px;z-index:50}
.card{background:var(--bg);border:1px solid var(--bd);border-radius:28px;padding:36px 32px;width:100%;max-width:400px;text-align:center}
.card h1{font-size:24px;font-weight:400;margin:8px 0 4px}
.card p{color:var(--tx2);margin:0 0 16px}
.card input{margin-bottom:10px;text-align:left}
.card .btn{width:100%;margin-top:6px}
.logo{width:56px;height:56px;border-radius:16px;background:var(--pr);color:var(--bg);display:inline-grid;place-items:center;font-size:30px}
.lnk{color:var(--pr);margin-top:12px;display:inline-block}
.or{color:var(--tx2);margin:12px 0 4px;font-size:12px}
/* app */
#app{display:grid;grid-template-columns:256px 1fr;grid-template-rows:64px 1fr;height:100%;background:var(--sf)}
header{grid-column:1/3;display:flex;align-items:center;gap:8px;padding:0 12px}
.brand{display:flex;align-items:center;gap:8px;font-size:22px;width:232px;color:var(--tx2)}
.brand i{font-style:normal;width:32px;height:32px;border-radius:8px;background:var(--pr);color:var(--bg);display:grid;place-items:center;font-size:18px}
.search{flex:1;max-width:720px;display:flex;align-items:center;background:var(--bg2);border-radius:24px;padding:0 8px}
.search input{border:0;background:none;height:46px;padding:0 8px}
.me{margin-left:auto}
aside{padding:8px 12px;overflow:auto}
.mk{display:flex;align-items:center;gap:12px;padding:16px 24px 16px 18px;border-radius:16px;background:var(--prbg);font-weight:500;margin:4px 0 16px;box-shadow:0 1px 3px #0003}
.mk b{font-size:24px;font-weight:400}
.nv{display:flex;align-items:center;gap:16px;width:100%;padding:0 20px;height:36px;border-radius:0 18px 18px 0;margin-left:-12px;padding-left:32px;text-align:left}
.nv:hover{background:var(--bg2)}
.nv.on{background:var(--prbg);font-weight:600}
.nv span{width:20px;text-align:center}
hr{border:0;border-top:1px solid var(--bd);margin:12px 0}
main{background:var(--bg);border-radius:16px 0 0 0;overflow:auto;margin-right:0}
.top{display:flex;justify-content:space-between;align-items:baseline;padding:16px 24px 8px;position:sticky;top:0;background:var(--bg);z-index:2}
.top h2{margin:0;font-weight:400;font-size:22px}
.top small{color:var(--tx2)}
.ltr{padding:14px 24px 4px;color:var(--tx2);font-weight:600}
.row{display:grid;grid-template-columns:48px 1.3fr 1.3fr 1fr 1fr 40px;align-items:center;gap:12px;padding:6px 24px;cursor:pointer;border-top:1px solid transparent}
.row:hover{background:var(--bg2)}
.row span{color:var(--tx2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.row b{font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.star{font-size:18px;color:var(--tx2)}
.av{width:36px;height:36px;border-radius:50%;object-fit:cover;color:#fff;display:grid;place-items:center;font-size:16px}
.av.big{width:96px;height:96px;font-size:44px}
.empty{padding:48px 24px;text-align:center;color:var(--tx2)}
/* dialogs */
dialog{border:0;border-radius:24px;padding:0;background:var(--bg);color:var(--tx);width:min(560px,100vw);max-height:92vh;box-shadow:0 8px 40px #0006}
dialog::backdrop{background:#0006}
.dh{display:flex;align-items:center;justify-content:space-between;padding:12px 16px 0}
.db{padding:8px 24px 20px}
.df{display:flex;justify-content:flex-end;gap:8px;padding:12px 24px;border-top:1px solid var(--bd);position:sticky;bottom:0;background:var(--bg)}
.hero{text-align:center;padding:8px 0 16px}
.hero h3{font-size:24px;font-weight:400;margin:10px 0 2px}
.hero p{margin:0;color:var(--tx2)}
.acts{display:flex;justify-content:center;gap:8px;margin-top:12px;flex-wrap:wrap}
.it{display:flex;gap:16px;padding:10px 0;align-items:flex-start;border-top:1px solid var(--bd)}
.it span:first-child{width:24px;color:var(--tx2)}
.it small{display:block;color:var(--tx2)}
.it a{color:var(--pr);text-decoration:none}
.rw{display:grid;grid-template-columns:110px 1fr 36px;gap:8px;margin-bottom:8px}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.ph{display:flex;align-items:center;gap:16px;margin-bottom:4px}
#toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:#323232;color:#fff;padding:12px 20px;border-radius:8px;z-index:99;opacity:0;pointer-events:none;transition:.2s}
#toast.on{opacity:1}
.fab{display:none}
@media(max-width:820px){
 #app{grid-template-columns:1fr}
 header{grid-column:1}
 .brand span{display:none}.brand{width:auto}
 aside{position:fixed;left:0;top:64px;bottom:0;width:270px;background:var(--sf);z-index:20;transform:translateX(-100%);transition:.2s;box-shadow:4px 0 16px #0003}
 aside.open{transform:none}
 main{border-radius:16px 16px 0 0}
 .row{grid-template-columns:48px 1fr 40px}
 .row span{display:none}
 .row b+span{display:block}
 .mk{display:none}
 .fab{display:grid;position:fixed;right:16px;bottom:20px;width:56px;height:56px;border-radius:16px;background:var(--prbg);font-size:30px;place-items:center;box-shadow:0 2px 8px #0005;z-index:5}
 .g2{grid-template-columns:1fr}
 dialog{max-height:100vh;height:100vh;border-radius:0}
}
</style>
</head>
<body>

<!-- LOGIN -->
<div id="auth" class="ov hide">
 <form class="card" id="authForm">
  <div class="logo">👤</div>
  <h1 id="aTitle">Ingia kwenye Contact</h1>
  <p>Anwani zako zote mahali pamoja</p>
  <input id="aEmail" type="email" placeholder="Barua pepe" autocomplete="email" required>
  <input id="aPass" type="password" placeholder="Password" autocomplete="current-password" required minlength="6">
  <div class="err" id="aErr"></div>
  <button class="btn p" id="aGo" type="submit">Ingia</button>
  <div class="or">au</div>
  <button class="btn t" id="aGoogle" type="button" style="border:1px solid var(--bd)">Endelea na Google</button><br>
  <button class="lnk" id="aSwitch" type="button">Huna akaunti? Jisajili</button><br>
  <button class="lnk" id="aReset" type="button">Umesahau password?</button>
 </form>
</div>

<!-- APP LOCK -->
<div id="lock" class="ov hide">
 <form class="card" id="lockForm">
  <div class="logo">🔒</div>
  <h1>Contact imefungwa</h1>
  <p>Weka password ya Contact kuendelea</p>
  <input id="lPass" type="password" placeholder="Password ya Contact" autocomplete="off">
  <div class="err" id="lErr"></div>
  <button class="btn p" type="submit">Fungua</button>
  <button class="lnk" id="lOut" type="button">Toka kwenye akaunti</button>
 </form>
</div>

<!-- APP -->
<div id="app" class="hide">
 <header>
  <button class="ib" id="menu" aria-label="Menyu">☰</button>
  <div class="brand"><i>👤</i><span>Contact</span></div>
  <div class="search"><span>🔍</span><input id="q" type="search" placeholder="Tafuta jina, namba au email"></div>
  <button class="ib me" id="settingsBtn" aria-label="Mipangilio">⚙</button>
 </header>
 <aside id="side">
  <button class="mk" id="newBtn"><b>＋</b> Unda mwasiliani</button>
  <button class="nv on" data-f="all"><span>👥</span>Anwani</button>
  <button class="nv" data-f="fav"><span>★</span>Vipendwa</button>
  <hr>
  <button class="nv" id="impBtn"><span>⬆</span>Ingiza (VCF)</button>
  <button class="nv" id="expBtn"><span>⬇</span>Hamisha (VCF)</button>
  <hr>
  <button class="nv" id="lockNow"><span>🔒</span>Funga sasa</button>
  <button class="nv" id="outBtn"><span>⎋</span>Toka</button>
 </aside>
 <main>
  <div class="top"><h2 id="title">Anwani</h2><small id="count"></small></div>
  <div id="list"></div>
 </main>
 <button class="fab" id="fab" aria-label="Unda mwasiliani">＋</button>
</div>
<input type="file" id="file" accept=".vcf,.vcard,text/vcard,text/x-vcard" multiple class="hide">
<input type="file" id="photoIn" accept="image/*" class="hide">

<!-- DETAIL -->
<dialog id="dDlg">
 <div class="dh"><button class="ib" data-close aria-label="Funga">✕</button><span><button class="ib" id="dFav" style="display:inline-grid">☆</button><button class="ib" id="dEdit" style="display:inline-grid" aria-label="Hariri">✎</button><button class="ib" id="dDel" style="display:inline-grid" aria-label="Futa">🗑</button></span></div>
 <div class="db" id="dv"></div>
</dialog>

<!-- FORM -->
<dialog id="fDlg">
 <form id="fForm" method="dialog">
  <div class="dh"><b style="font-size:18px;font-weight:400;padding-left:8px" id="fTitle">Mwasiliani mpya</b><button class="ib" type="button" data-close aria-label="Funga">✕</button></div>
  <div class="db">
   <div class="ph"><div id="fAv"></div><button class="btn t" type="button" id="phBtn">Weka picha</button><button class="btn t" type="button" id="phDel">Ondoa</button></div>
   <div class="g2"><div><label>Jina la kwanza</label><input id="fFirst"></div><div><label>Jina la mwisho</label><input id="fLast"></div></div>
   <div class="g2"><div><label>Kampuni / Taasisi</label><input id="fCo"></div><div><label>Cheo</label><input id="fTitle2"></div></div>
   <label>Namba za simu</label><div id="fPh"></div><button class="btn t" type="button" id="addPh">＋ Ongeza namba</button>
   <label>Barua pepe</label><div id="fEm"></div><button class="btn t" type="button" id="addEm">＋ Ongeza email</button>
   <label>Anwani / Makazi</label><input id="fAddr">
   <div class="g2"><div><label>Siku ya kuzaliwa</label><input id="fBday" type="date"></div><div><label>Tovuti</label><input id="fWeb" type="url" placeholder="https://"></div></div>
   <label>Maelezo</label><textarea id="fNotes"></textarea>
  </div>
  <div class="df"><button class="btn t" type="button" data-close>Ghairi</button><button class="btn p" type="submit">Hifadhi</button></div>
 </form>
</dialog>

<!-- SETTINGS -->
<dialog id="sDlg">
 <div class="dh"><b style="font-size:18px;font-weight:400;padding-left:8px">Mipangilio</b><button class="ib" data-close aria-label="Funga">✕</button></div>
 <div class="db">
  <p id="sUser" style="color:var(--tx2)"></p>
  <b>Password ya Contact (si lazima)</b>
  <p style="color:var(--tx2);margin:4px 0">Ukiiweka, itaombwa kila ukifungua Contact. Ikipotea haiwezi kurejeshwa — utatakiwa kutoka na kuingia upya (data ya kifaa hiki inabaki).</p>
  <label id="sLbl">Password mpya</label>
  <input id="sPass" type="password" autocomplete="new-password" placeholder="Angalau herufi 4">
  <div class="err" id="sErr"></div>
  <button class="btn p" id="sSave">Hifadhi password</button>
  <button class="btn d hide" id="sRemove">Ondoa password</button>
  <hr>
  <b>Takwimu</b>
  <p id="sStat" style="color:var(--tx2);margin:4px 0"></p>
  <button class="btn d" id="sWipe">Futa anwani zote</button>
 </div>
</dialog>

<div id="toast"></div>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script>
const firebaseConfig = {
  apiKey: "AIzaSyDh05C50ezVo6Msus1sh7sfxXoV0ORbVMk",
  authDomain: "smschat-af3e5.firebaseapp.com",
  projectId: "smschat-af3e5",
  storageBucket: "smschat-af3e5.firebasestorage.app",
  messagingSenderId: "259144985126",
  appId: "1:259144985126:web:b4be607c6a4e5836e614e7",
  measurementId: "G-7RRE3Q7E81"
};
firebase.initializeApp(firebaseConfig);
const auth = firebase.auth();

const $ = s => document.querySelector(s);
const E = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let db, contacts = [], cur = null, filter = 'all', q = '', photo = '', editing = null, isSignup = false, unlocked = false, user = null;

/* ---------- IndexedDB ---------- */
function openDB(n){return new Promise((ok,no)=>{const r=indexedDB.open(n,1);
 r.onupgradeneeded=()=>{r.result.createObjectStore('contacts',{keyPath:'id'});r.result.createObjectStore('meta')};
 r.onsuccess=()=>ok(r.result);r.onerror=()=>no(r.error)})}
const st=(n,m='readonly')=>db.transaction(n,m).objectStore(n);
const rq=r=>new Promise((ok,no)=>{r.onsuccess=()=>ok(r.result);r.onerror=()=>no(r.error)});
const dbAll=()=>rq(st('contacts').getAll());
const dbPut=c=>rq(st('contacts','readwrite').put(c));
const dbDel=id=>rq(st('contacts','readwrite').delete(id));
const getM=k=>rq(st('meta').get(k));
const setM=(k,v)=>rq(st('meta','readwrite').put(v,k));
const delM=k=>rq(st('meta','readwrite').delete(k));
function dbBulk(list){return new Promise((ok,no)=>{const t=db.transaction('contacts','readwrite');const s=t.objectStore('contacts');list.forEach(c=>s.put(c));t.oncomplete=ok;t.onerror=()=>no(t.error)})}
function dbClear(){return rq(st('contacts','readwrite').clear())}

/* ---------- Helpers ---------- */
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,8);
const nm=c=>[c.first,c.last].filter(Boolean).join(' ')||c.company||c.phones[0]?.v||c.emails[0]?.v||'(Bila jina)';
const cols=['#1a73e8','#d93025','#188038','#e37400','#9334e6','#007b83','#c2185b','#5f6368'];
const colr=s=>cols[[...s].reduce((a,c)=>a+c.charCodeAt(0),0)%cols.length];
const av=(c,cl='')=>c.photo?`<img class="av ${cl}" src="${c.photo}" alt="">`:`<div class="av ${cl}" style="background:${colr(nm(c))}">${E((nm(c)[0]||'?').toUpperCase())}</div>`;
const digits=s=>String(s).replace(/\D/g,'');
function toast(t){const e=$('#toast');e.textContent=t;e.classList.add('on');clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.remove('on'),2800)}
async function hash(p,s){const b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(s+p));return [...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('')}
const PT=['Simu','Kazi','Nyumbani','Nyingine'], ET=['Binafsi','Kazi','Nyingine'];

/* ---------- Auth ---------- */
function authMode(s){isSignup=s;$('#aTitle').textContent=s?'Fungua akaunti':'Ingia kwenye Contact';$('#aGo').textContent=s?'Jisajili':'Ingia';$('#aSwitch').textContent=s?'Tayari una akaunti? Ingia':'Huna akaunti? Jisajili';$('#aPass').autocomplete=s?'new-password':'current-password'}
const aMsg=e=>({'auth/invalid-credential':'Barua pepe au password si sahihi.','auth/wrong-password':'Password si sahihi.','auth/user-not-found':'Akaunti haipo.','auth/email-already-in-use':'Barua pepe hii tayari imesajiliwa.','auth/weak-password':'Password iwe angalau herufi 6.','auth/network-request-failed':'Hakuna mtandao.','auth/unauthorized-domain':'Domain hii haijaruhusiwa kwenye Firebase (Authorized domains).','auth/too-many-requests':'Majaribio mengi. Jaribu baadaye.'}[e.code]||e.message);
$('#aSwitch').onclick=()=>authMode(!isSignup);
$('#authForm').onsubmit=async e=>{e.preventDefault();$('#aErr').textContent='';
 try{const f=isSignup?auth.createUserWithEmailAndPassword:auth.signInWithEmailAndPassword;await f.call(auth,$('#aEmail').value.trim(),$('#aPass').value)}catch(x){$('#aErr').textContent=aMsg(x)}};
$('#aGoogle').onclick=async()=>{$('#aErr').textContent='';try{await auth.signInWithPopup(new firebase.auth.GoogleAuthProvider())}catch(x){$('#aErr').textContent=aMsg(x)}};
$('#aReset').onclick=async()=>{const m=$('#aEmail').value.trim();if(!m){$('#aErr').textContent='Andika barua pepe kwanza.';return}
 try{await auth.sendPasswordResetEmail(m);$('#aErr').style.color='var(--pr)';$('#aErr').textContent='Link ya kubadili password imetumwa.'}catch(x){$('#aErr').style.color='';$('#aErr').textContent=aMsg(x)}};
const logout=()=>{unlocked=false;auth.signOut()};
$('#outBtn').onclick=logout;$('#lOut').onclick=logout;

auth.onAuthStateChanged(async u=>{
 user=u;
 if(!u){if(db){db.close();db=null}contacts=[];$('#app').classList.add('hide');$('#lock').classList.add('hide');$('#auth').classList.remove('hide');return}
 $('#auth').classList.add('hide');
 db=await openDB('contact_'+u.uid);
 contacts=await dbAll();
 $('#app').classList.remove('hide');render();
 if(await getM('lock')&&!unlocked)showLock();
});

/* ---------- Lock ---------- */
function showLock(){$('#lPass').value='';$('#lErr').textContent='';$('#lock').classList.remove('hide');setTimeout(()=>$('#lPass').focus(),50)}
$('#lockForm').onsubmit=async e=>{e.preventDefault();const l=await getM('lock');
 if(l&&await hash($('#lPass').value,l.salt)===l.hash){unlocked=true;$('#lock').classList.add('hide')}else $('#lErr').textContent='Password si sahihi.'};
$('#lockNow').onclick=async()=>{if(await getM('lock')){unlocked=false;showLock()}else{toast('Weka password kwanza kwenye Mipangilio');openSettings()}};

/* ---------- List ---------- */
function render(){
 const l=contacts.filter(c=>(filter!=='fav'||c.fav)&&(!q||(nm(c)+' '+c.company+' '+c.phones.map(p=>p.v).join(' ')+' '+c.emails.map(e=>e.v).join(' ')).toLowerCase().includes(q)||(digits(q)&&c.phones.some(p=>digits(p.v).includes(digits(q))))));
 l.sort((a,b)=>nm(a).localeCompare(nm(b)));
 $('#count').textContent=l.length+' '+(l.length===1?'mwasiliani':'wawasiliani');
 let h='',L='';
 for(const c of l){const ch=(nm(c)[0]||'#').toUpperCase();if(ch!==L){L=ch;h+=`<div class="ltr">${E(ch)}</div>`}
  h+=`<div class="row" data-id="${c.id}">${av(c)}<b>${E(nm(c))}</b><span>${E(c.emails[0]?.v||'')}</span><span>${E(c.phones[0]?.v||'')}</span><span>${E(c.company)}</span><button class="star" data-fav="${c.id}" aria-label="Kipendwa">${c.fav?'★':'☆'}</button></div>`}
 $('#list').innerHTML=h||`<p class="empty">${q?'Hakuna aliyepatikana.':filter==='fav'?'Hakuna vipendwa bado.':'Hakuna anwani bado. Bonyeza “Unda mwasiliani” au ingiza faili la VCF.'}</p>`;
}
$('#list').onclick=async e=>{
 const f=e.target.closest('[data-fav]');if(f){const c=contacts.find(x=>x.id===f.dataset.fav);c.fav=!c.fav;await dbPut(c);render();return}
 const r=e.target.closest('.row');if(r)showDetail(r.dataset.id)};
$('#q').oninput=e=>{q=e.target.value.trim().toLowerCase();render()};
document.querySelectorAll('.nv[data-f]').forEach(b=>b.onclick=()=>{filter=b.dataset.f;document.querySelectorAll('.nv[data-f]').forEach(x=>x.classList.toggle('on',x===b));$('#title').textContent=filter==='fav'?'Vipendwa':'Anwani';$('#side').classList.remove('open');render()});
$('#menu').onclick=()=>$('#side').classList.toggle('open');
document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>b.closest('dialog').close());

/* ---------- Detail ---------- */
function showDetail(id){
 const c=contacts.find(x=>x.id===id);if(!c)return;cur=c;
 const it=(i,body)=>`<div class="it"><span>${i}</span><div>${body}</div></div>`;
 let h=`<div class="hero">${av(c,'big')}<h3>${E(nm(c))}</h3><p>${E([c.title,c.company].filter(Boolean).join(', '))}</p>
 <div class="acts">${c.phones[0]?`<a class="btn t" style="border:1px solid var(--bd);text-decoration:none" href="tel:${E(c.phones[0].v)}">📞 Piga</a><a class="btn t" style="border:1px solid var(--bd);text-decoration:none" href="sms:${E(c.phones[0].v)}">💬 SMS</a>`:''}${c.emails[0]?`<a class="btn t" style="border:1px solid var(--bd);text-decoration:none" href="mailto:${E(c.emails[0].v)}">✉ Email</a>`:''}</div></div>`;
 c.phones.forEach(p=>h+=it('📞',`<a href="tel:${E(p.v)}">${E(p.v)}</a><small>${E(p.t)}</small>`));
 c.emails.forEach(p=>h+=it('✉',`<a href="mailto:${E(p.v)}">${E(p.v)}</a><small>${E(p.t)}</small>`));
 if(c.address)h+=it('📍',E(c.address));
 if(c.bday)h+=it('🎂',E(c.bday));
 if(c.web)h+=it('🌐',`<a href="${E(c.web)}" target="_blank" rel="noopener">${E(c.web)}</a>`);
 if(c.notes)h+=it('📝',E(c.notes).replace(/\n/g,'<br>'));
 $('#dv').innerHTML=h;$('#dFav').textContent=c.fav?'★':'☆';$('#dDlg').showModal()}
$('#dFav').onclick=async()=>{cur.fav=!cur.fav;await dbPut(cur);$('#dFav').textContent=cur.fav?'★':'☆';render()};
$('#dEdit').onclick=()=>{$('#dDlg').close();openForm(cur)};
$('#dDel').onclick=async()=>{if(confirm(`Futa ${nm(cur)}?`)){await dbDel(cur.id);contacts=contacts.filter(x=>x.id!==cur.id);$('#dDlg').close();render();toast('Imefutwa')}};

/* ---------- Form ---------- */
function rowEl(kind,t,v){const d=document.createElement('div');d.className='rw';const o=(kind==='ph'?PT:ET);
 d.innerHTML=`<select>${o.map(x=>`<option${x===t?' selected':''}>${x}</option>`).join('')}</select><input type="${kind==='ph'?'tel':'email'}" value="${E(v||'')}" placeholder="${kind==='ph'?'Namba ya simu':'Barua pepe'}"><button type="button" class="ib" aria-label="Ondoa">✕</button>`;
 d.querySelector('button').onclick=()=>d.remove();return d}
const addRow=(k,t,v)=>$(k==='ph'?'#fPh':'#fEm').appendChild(rowEl(k,t,v));
$('#addPh').onclick=()=>addRow('ph','Simu','');$('#addEm').onclick=()=>addRow('em','Binafsi','');
function setPhoto(p){photo=p;$('#fAv').innerHTML=photo?`<img class="av big" src="${photo}" alt="">`:`<div class="av big" style="background:var(--bg2);color:var(--tx2)">👤</div>`;$('#phDel').classList.toggle('hide',!photo)}
$('#phBtn').onclick=()=>$('#photoIn').click();$('#phDel').onclick=()=>setPhoto('');
$('#photoIn').onchange=e=>{const f=e.target.files[0];e.target.value='';if(!f)return;const im=new Image();im.onload=()=>{const s=256,r=Math.min(1,s/Math.min(im.width,im.height)),cv=document.createElement('canvas');
 cv.width=Math.round(im.width*r);cv.height=Math.round(im.height*r);cv.getContext('2d').drawImage(im,0,0,cv.width,cv.height);setPhoto(cv.toDataURL('image/jpeg',.82))};im.src=URL.createObjectURL(f)};
function openForm(c){editing=c;$('#fTitle').textContent=c?'Hariri mwasiliani':'Mwasiliani mpya';
 $('#fFirst').value=c?.first||'';$('#fLast').value=c?.last||'';$('#fCo').value=c?.company||'';$('#fTitle2').value=c?.title||'';
 $('#fAddr').value=c?.address||'';$('#fBday').value=c?.bday||'';$('#fWeb').value=c?.web||'';$('#fNotes').value=c?.notes||'';
 $('#fPh').innerHTML='';$('#fEm').innerHTML='';
 (c?.phones.length?c.phones:[{t:'Simu',v:''}]).forEach(p=>addRow('ph',p.t,p.v));(c?.emails||[]).forEach(p=>addRow('em',p.t,p.v));
 setPhoto(c?.photo||'');$('#fDlg').showModal();$('#fFirst').focus()}
$('#newBtn').onclick=()=>{$('#side').classList.remove('open');openForm(null)};$('#fab').onclick=()=>openForm(null);
const rows=id=>[...document.querySelectorAll(id+' .rw')].map(r=>({t:r.querySelector('select').value,v:r.querySelector('input').value.trim()})).filter(x=>x.v);
$('#fForm').onsubmit=async e=>{e.preventDefault();
 const c={...(editing||{id:uid(),fav:false,created:Date.now()}),first:$('#fFirst').value.trim(),last:$('#fLast').value.trim(),company:$('#fCo').value.trim(),title:$('#fTitle2').value.trim(),
  phones:rows('#fPh'),emails:rows('#fEm'),address:$('#fAddr').value.trim(),bday:$('#fBday').value,web:$('#fWeb').value.trim(),notes:$('#fNotes').value.trim(),photo,updated:Date.now()};
 if(!c.first&&!c.last&&!c.company&&!c.phones.length&&!c.emails.length){toast('Weka angalau jina au namba');return}
 await dbPut(c);const i=contacts.findIndex(x=>x.id===c.id);i>=0?contacts[i]=c:contacts.push(c);
 $('#fDlg').close();render();toast('Imehifadhiwa')};

/* ---------- VCF import / export ---------- */
$('#impBtn').onclick=()=>{$('#side').classList.remove('open');$('#file').click()};
const ptype=p=>/CELL|MOBILE|VOICE/.test(p)&&!/WORK|HOME/.test(p)?'Simu':/WORK/.test(p)?'Kazi':/HOME/.test(p)?'Nyumbani':/CELL/.test(p)?'Simu':'Nyingine';
const etype=p=>/WORK/.test(p)?'Kazi':/HOME|PERSONAL/.test(p)?'Binafsi':'Nyingine';
function qp(s){try{const b=[];s.replace(/=([0-9A-F]{2})|([^=])/gi,(m,h,ch)=>{if(h)b.push(parseInt(h,16));else for(const x of new TextEncoder().encode(ch))b.push(x)});return new TextDecoder().decode(new Uint8Array(b))}catch{return s}}
const unesc=s=>s.replace(/\\n/gi,'\n').replace(/\\([,;\\])/g,'$1');
function parseVCF(t){
 t=t.replace(/\r\n?/g,'\n').replace(/=\n/g,'').replace(/\n[ \t]/g,'');
 const out=[];
 for(const blk of t.split(/BEGIN:VCARD/i).slice(1)){
  const c={id:uid(),first:'',last:'',company:'',title:'',phones:[],emails:[],address:'',bday:'',web:'',notes:'',photo:'',fav:false,created:Date.now()};let fn='';
  for(const ln of blk.split('\n')){
   const i=ln.indexOf(':');if(i<1)continue;
   const left=ln.slice(0,i),P=left.toUpperCase(),n=P.split(';')[0].split('.').pop();let v=ln.slice(i+1);
   if(/QUOTED-PRINTABLE/.test(P))v=qp(v);
   switch(n){
    case 'N':{const p=v.split(';').map(unesc);c.last=(p[0]||'').trim();c.first=[p[1],p[2]].filter(Boolean).join(' ').trim();break}
    case 'FN':fn=unesc(v).trim();break;
    case 'ORG':c.company=unesc(v.split(';')[0]).trim();break;
    case 'TITLE':c.title=unesc(v).trim();break;
    case 'TEL':if(v.trim())c.phones.push({t:ptype(P),v:v.replace(/^tel:/i,'').trim()});break;
    case 'EMAIL':if(v.trim())c.emails.push({t:etype(P),v:v.trim()});break;
    case 'ADR':c.address=v.split(';').map(unesc).filter(Boolean).join(', ');break;
    case 'BDAY':{const m=v.replace(/-/g,'').match(/^(\d{4})(\d{2})(\d{2})/);if(m)c.bday=`${m[1]}-${m[2]}-${m[3]}`;break}
    case 'URL':c.web=v.trim();break;
    case 'NOTE':c.notes=unesc(v).trim();break;
    case 'X-FAVORITE':case 'X-STARRED':c.fav=/1|true|yes/i.test(v);break;
    case 'PHOTO':{if(/^data:/i.test(v))c.photo=v;else if(/ENCODING=B|BASE64|VALUE=BINARY/.test(P)||/^[A-Za-z0-9+\/=]{100,}$/.test(v)){const ty=(P.match(/(?:TYPE=|;)(JPEG|JPG|PNG|GIF)/)||[])[1]||'JPEG';c.photo=`data:image/${ty.toLowerCase().replace('jpg','jpeg')};base64,${v.trim()}`}break}
   }
  }
  if(!c.first&&!c.last&&fn){const p=fn.split(' ');c.first=p.shift();c.last=p.join(' ')}
  if(c.first||c.last||c.company||c.phones.length||c.emails.length)out.push(c)}
 return out}
$('#file').onchange=async e=>{const fs=[...e.target.files];e.target.value='';if(!fs.length)return;
 let all=[];for(const f of fs)all=all.concat(parseVCF(await f.text()));
 const key=c=>nm(c).toLowerCase()+'|'+digits(c.phones[0]?.v||c.emails[0]?.v||'');
 const have=new Set(contacts.map(key));const add=[];
 for(const c of all){const k=key(c);if(!have.has(k)){have.add(k);add.push(c)}}
 if(add.length){await dbBulk(add);contacts=contacts.concat(add);render()}
 toast(`Zimeingizwa ${add.length}`+(all.length-add.length?`, zilizojirudia ${all.length-add.length} zimerukwa`:''))};
const ve=s=>String(s||'').replace(/([,;\\])/g,'\\$1').replace(/\n/g,'\\n');
const pt=t=>({Simu:'CELL',Kazi:'WORK',Nyumbani:'HOME'}[t]||'VOICE'), et=t=>({Kazi:'WORK',Binafsi:'HOME'}[t]||'INTERNET');
$('#expBtn').onclick=()=>{
 if(!contacts.length){toast('Hakuna anwani za kuhamisha');return}
 const o=contacts.map(c=>{const l=['BEGIN:VCARD','VERSION:3.0',`N:${ve(c.last)};${ve(c.first)};;;`,`FN:${ve(nm(c))}`];
  if(c.company)l.push('ORG:'+ve(c.company));if(c.title)l.push('TITLE:'+ve(c.title));
  c.phones.forEach(p=>l.push(`TEL;TYPE=${pt(p.t)}:${p.v}`));c.emails.forEach(p=>l.push(`EMAIL;TYPE=${et(p.t)}:${p.v}`));
  if(c.address)l.push('ADR;TYPE=HOME:;;'+ve(c.address)+';;;;');if(c.bday)l.push('BDAY:'+c.bday);if(c.web)l.push('URL:'+c.web);if(c.notes)l.push('NOTE:'+ve(c.notes));
  if(c.photo&&c.photo.startsWith('data:image/jpeg'))l.push('PHOTO;ENCODING=b;TYPE=JPEG:'+c.photo.split(',')[1]);
  l.push('END:VCARD');return l.join('\r\n')}).join('\r\n')+'\r\n';
 const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([o],{type:'text/vcard'}));a.download='contacts.vcf';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),2000);toast('Imehamishwa: contacts.vcf')};

/* ---------- Settings ---------- */
async function openSettings(){
 const l=await getM('lock');$('#sUser').textContent=user?.email||'';$('#sPass').value='';$('#sErr').textContent='';
 $('#sLbl').textContent=l?'Password mpya ya Contact':'Password mpya';$('#sRemove').classList.toggle('hide',!l);
 $('#sStat').textContent=`Anwani: ${contacts.length} · Zimehifadhiwa kwenye kifaa hiki (IndexedDB)`;
 $('#sDlg').showModal()}
$('#settingsBtn').onclick=openSettings;
$('#sSave').onclick=async()=>{const p=$('#sPass').value;if(p.length<4){$('#sErr').textContent='Password iwe angalau herufi 4.';return}
 const salt=uid()+uid();await setM('lock',{salt,hash:await hash(p,salt)});unlocked=true;$('#sDlg').close();toast('Password imewekwa')};
$('#sRemove').onclick=async()=>{if(confirm('Ondoa password ya Contact?')){await delM('lock');$('#sDlg').close();toast('Password imeondolewa')}};
$('#sWipe').onclick=async()=>{if(confirm('Futa anwani ZOTE? Hili haliwezi kurudishwa.')){await dbClear();contacts=[];render();$('#sDlg').close();toast('Anwani zote zimefutwa')}};

if('serviceWorker' in navigator&&location.protocol.startsWith('http')){/* ongeza service worker baadaye kwa matumizi bila mtandao */}
</script>
